{
  "name": "waymark-career",
  "version": "1.0.0",
  "private": true,
  "description": "Static multilingual career and HR consulting website.",
  "scripts": {
    "build": "python3 scripts/build-seo.py",
    "check": "python3 scripts/check-seo.py",
    "test": "npm run check && npm run test:build && node --test scripts/check-*.cjs",
    "format": "prettier --write src scripts/*.cjs index.html .prettierrc.json package.json",
    "format:check": "prettier --check src scripts/*.cjs index.html .prettierrc.json package.json",
    "test:build": "python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "pretest": "npm run build"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "prettier": "3.8.3"
  }
}
